envtools: program NAND by page, skip erased pages and verify every block

--- a/tools/env/fw_env.c
+++ b/tools/env/fw_env.c
@@ -997,6 +997,9 @@
 				   MEMGETBADBLOCK needs 64 bits */
 	int was_locked = 0;	/* flash lock flag */
 	int rc;
+	struct mtd_info_user mtdinfo;
+	size_t page, page_size = 0;
+	unsigned char *verify = NULL;
 
 	/*
 	 * For mtd devices only offset and size of the environment do matter
@@ -1070,6 +1073,18 @@
 		data = buf;
 	}
 
+	/* Validate NAND geometry and allocate readback before erasing anything. */
+	if (DEVTYPE(dev) == MTD_NANDFLASH) {
+		if (ioctl(fd, MEMGETINFO, &mtdinfo) || !mtdinfo.writesize ||
+		    erasesize % mtdinfo.writesize) {
+			fprintf(stderr, "Invalid NAND page geometry on %s\n", DEVNAME(dev));
+			return -1;
+		}
+		page_size = mtdinfo.writesize;
+		verify = malloc(erasesize);
+		if (!verify)
+			return -1;
+	}
 	erase.length = erasesize;
 
 	/* This only runs once on NOR flash and SPI-dataflash */
@@ -1118,7 +1133,34 @@
 			(unsigned long long)erasesize,
 			(unsigned long long)blockstart);
 #endif
-		if (write(fd, data + processed, erasesize) != erasesize) {
+		if (page_size) {
+			/* Program NAND a page at a time. Leave erased pages erased;
+			 * do not manufacture ECC/OOB for an all-0xff data page.
+			 */
+			for (page = 0; page < erasesize; page += page_size) {
+				unsigned char *src = (unsigned char *)data + processed + page;
+				size_t j;
+
+				for (j = 0; j < page_size && src[j] == 0xff; j++)
+					;
+				if (j == page_size)
+					continue;
+				if (lseek(fd, blockstart + page, SEEK_SET) == -1 ||
+				    write(fd, src, page_size) != page_size) {
+					fprintf(stderr, "NAND page write error on %s at 0x%llx: %s\n",
+						DEVNAME(dev), (unsigned long long)(blockstart + page),
+						strerror(errno));
+					free(verify);
+					return -1;
+				}
+			}
+			rc = flash_read_buf(dev, fd, verify, erasesize, blockstart);
+			if (rc != erasesize || memcmp(verify, data + processed, erasesize)) {
+				fprintf(stderr, "NAND environment readback failed on %s\n", DEVNAME(dev));
+				free(verify);
+				return -1;
+			}
+		} else if (write(fd, data + processed, erasesize) != erasesize) {
 			fprintf(stderr, "Write error on %s: %s\n",
 				DEVNAME(dev), strerror(errno));
 			return -1;
@@ -1134,6 +1176,7 @@
 		blockstart += erasesize;
 	}
 
+	free(verify);
 	if (write_total > count)
 		free(data);
 
