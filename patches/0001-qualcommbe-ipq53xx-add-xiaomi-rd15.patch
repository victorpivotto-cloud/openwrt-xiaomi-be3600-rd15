Subject: qualcommbe: ipq53xx: add Xiaomi BE3600 2.5G (RD15)

Changes to files that already exist in fivefold3/openwrt-gl-be3600 at
BASE_COMMIT (new files live under openwrt-tree/):

- image/ipq53xx.mk: device xiaomi_rd15 (LZMA FIT, FIT config
  config@mi04.1-c2 as requested by the stock bootmiwifi, UBI layout, kernel
  size limited to the stock "kernel" UBI volume, uboot-envtools).
- board.d/02_network: lan = lan1 lan2 lan3 (YT9215S DSA user ports).
- hotplug.d/firmware/12-ath12k-caldata: reuse the GL-BE3600 ART offsets
  (same AP-MI04.1-C2 reference board) for both radios.
- config-default: build the backported yt921x DSA driver and tagger.

SPDX-License-Identifier: GPL-2.0-only
---
diff --git a/target/linux/qualcommbe/image/ipq53xx.mk b/target/linux/qualcommbe/image/ipq53xx.mk
index b03277fc33..e4f0606d8f 100644
--- a/target/linux/qualcommbe/image/ipq53xx.mk
+++ b/target/linux/qualcommbe/image/ipq53xx.mk
@@ -162,3 +162,22 @@ define Device/glinet_gl-be9300
 		block-mount blockd usbutils
 endef
 TARGET_DEVICES += glinet_gl-be9300
+
+define Device/xiaomi_rd15
+	$(call Device/FitImageLzma)
+	$(call Device/UbiFit)
+	DEVICE_VENDOR := Xiaomi
+	DEVICE_MODEL := BE3600 2.5G
+	DEVICE_VARIANT := RD15
+	DEVICE_DTS := ipq5332-xiaomi-rd15
+	# Stock APPSBL board table contains config@mi04.1-c2 (strings on the
+	# saved 0:APPSBL), and bootmiwifi requests it from the kernel FIT.
+	DEVICE_DTS_CONFIG := config@mi04.1-c2
+	SOC := ipq5332
+	BLOCKSIZE := 128k
+	PAGESIZE := 2048
+	# Stock UBI volume "kernel" is 83 LEBs: 10539008 bytes.
+	KERNEL_SIZE := 10292k
+	DEVICE_PACKAGES := kmod-ath12k ath12k-firmware-ipq5332 kmod-qrtr-smd uboot-envtools
+endef
+TARGET_DEVICES += xiaomi_rd15
diff --git a/target/linux/qualcommbe/ipq53xx/base-files/etc/board.d/02_network b/target/linux/qualcommbe/ipq53xx/base-files/etc/board.d/02_network
index 3d4a1c0c4e..cd57343e1f 100644
--- a/target/linux/qualcommbe/ipq53xx/base-files/etc/board.d/02_network
+++ b/target/linux/qualcommbe/ipq53xx/base-files/etc/board.d/02_network
@@ -15,6 +15,10 @@ ipq53xx_setup_interfaces()
 	ubnt,u7-pro-xgs)
 		ucidef_set_interface_lan "lan"
 		;;
+	xiaomi,rd15)
+		# YT9215S DSA user ports; the 2.5G port (YT8821) is not wired yet
+		ucidef_set_interface_lan "lan1 lan2 lan3"
+		;;
 	gl.inet,gl-be3600)
 		ucidef_set_interfaces_lan_wan "lan" "wan"
 		# The ports take their addresses from the ART nvmem cell in the
diff --git a/target/linux/qualcommbe/ipq53xx/base-files/etc/hotplug.d/firmware/12-ath12k-caldata b/target/linux/qualcommbe/ipq53xx/base-files/etc/hotplug.d/firmware/12-ath12k-caldata
index ef0e32e31e..08e9088c67 100644
--- a/target/linux/qualcommbe/ipq53xx/base-files/etc/hotplug.d/firmware/12-ath12k-caldata
+++ b/target/linux/qualcommbe/ipq53xx/base-files/etc/hotplug.d/firmware/12-ath12k-caldata
@@ -7,7 +7,8 @@ board=$(board_name)
 case "$FIRMWARE" in
 "ath12k/IPQ5332/hw1.0/cal-ahb-c000000.wifi.bin")
 	case "$board" in
-	gl.inet,gl-be3600)
+	gl.inet,gl-be3600|\
+	xiaomi,rd15)
 		# 0x11800 is the region ftm.conf allocates to this radio on the
 		# ap-mi04.1-c2 board (row "ap-mi04.1-c2,42,0,4096,71680,255"), ending
 		# exactly where the QCN6432 block starts (0x12800). Region-sized rather
@@ -25,7 +26,8 @@ case "$FIRMWARE" in
 	;;
 "ath12k/QCN6432/hw1.0/cal-ahb-soc@0:wifi-qcn6432.bin")
 	case "$board" in
-	gl.inet,gl-be3600)
+	gl.inet,gl-be3600|\
+	xiaomi,rd15)
 		# QCN6432 (5 GHz) block: offset 0x12800 and region 0x1b800 straight from
 		# ftm.conf ("ap-mi04.1-c2,0053,1,75776,112640,0"). Region-sized for the
 		# same reason as above (the tested unit's block is 0x18800).
diff --git a/target/linux/qualcommbe/ipq53xx/config-default b/target/linux/qualcommbe/ipq53xx/config-default
index 543a01e395..f1525581cb 100644
--- a/target/linux/qualcommbe/ipq53xx/config-default
+++ b/target/linux/qualcommbe/ipq53xx/config-default
@@ -94,3 +94,5 @@ CONFIG_TOUCHSCREEN_HYNITRON_CST816X=y
 # ARMv8 Crypto Extensions for AES modes and GCM
 CONFIG_CRYPTO_AES_ARM64_CE_BLK=y
 CONFIG_CRYPTO_GHASH_ARM64_CE=y
+CONFIG_NET_DSA_YT921X=y
+CONFIG_NET_DSA_TAG_YT921X=y
